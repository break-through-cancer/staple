nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Just check samplesheet and read visium to adata") {

        tag "samplesheet"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/samplesheet-test.csv"
                deconvolve {
                    external = false
                    bayestme = false
                    cogaps   = false
                    rctd     = false
                }
                analyze {
                    spacemarkers = false
                    squidpy = false
                }
                outdir = "output"
                max_memory = "8.GB"
                max_cpus = 4
            }
        }

        then {
            assertAll (
                { assert workflow.success },
                { assert file("${outputDir}/pipeline_info/samplesheet.valid.csv").exists() }
            )

        }

    }

    test("Fail on empty samplesheet") {

        tag "samplesheet"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/samplesheet-empty-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
            }
        }

        then {
            assert workflow.success == false
        }

    }

    test("RCTD on Visium SD with local ref") {

        tag "local"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/localatlas-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                    external = false
                }
                analyze {
                    spacemarkers = false
                    squidpy = false
                }
            }
        }

        then {
            assertAll { 
                assert workflow.success 
            }


        }
    }

    test("RCTD on Multisample Visium SD with local matched ref scRNA") {

        tag "multisample"
        tag "pipeline"
        when {
            params {
                input = "../../../tests/data/samplesheets/multisample-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                }
                analyze {
                    spacemarkers = false
                    squidpy = true
                    xsample = true
                }
            }
        }

        then {
            assertAll(
                { assert workflow.success
                  assert file("${outputDir}/multiqc/multiqc_report.html").exists() },
            )

        }
    }

    test("RCTD on Multisample Visium SD with local file as param") {

        tag "multisample"
        tag "localfile"
        tag "pipeline"
        when {
            params {
                input = "../../../tests/data/samplesheets/multisample-test.csv"
                ref_scrna = "${projectDir}/tests/data/atlas_small.h5ad"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                }
                analyze {
                    spacemarkers = false
                    squidpy = true
                    xsample = true
                }
            }
        }

        then {
            assertAll(
                { assert workflow.success
                  assert file("${outputDir}/multiqc/multiqc_report.html").exists() },
            )

        }
    }

    test("RCTD full pipeline on Visium SD with remote ref") {

        tag "visiumsd"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/sdvisium-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                    external = false
                    n_top_genes = 500
                }
                analyze {
                    spacemarkers = true
                    squidpy = true
                    xsample = true

                }

                ref_scrna = "https://datasets.cellxgene.cziscience.com/6c29f947-d85b-483e-b346-b163277dae5e.h5ad"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert file("${outputDir}/adata/sample1/adata.h5ad").exists() },
                { assert file("${outputDir}/atlas/${params.ref_scrna.tokenize("/")[-1]}").exists() },
                { assert file("${outputDir}/atlas/sample1/adata_matched.h5ad").exists() },
                { assert file("${outputDir}/rctd/sample1/rctd_cell_types.csv").exists() },
                { assert file("${outputDir}/spacemarkers/sample1/rctd_cell_types/IMScores.rds").exists() },
                { assert file("${outputDir}/squidpy/sample1/rctd/figures/spatial_scatter.png").exists() },
                { assert file("${outputDir}/multiqc/multiqc_report.html").exists() }
            )
        }

    }

    test("RCTD full pipeline on Visium HD with remote ref") {

        tag "visiumhd"
        tag "pipeline"
        when {
            params {
                input = "../../../tests/data/samplesheets/hdvisium-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                    external = false
                }
                analyze {
                    spacemarkers = true
                    squidpy = true
                }
                visium_hd = "square_016um"
                ref_scrna = "https://datasets.cellxgene.cziscience.com/6c29f947-d85b-483e-b346-b163277dae5e.h5ad"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert file("${outputDir}/adata/sample1/adata.h5ad").exists() },
                { assert file("${outputDir}/atlas/${params.ref_scrna.tokenize("/")[-1]}").exists() },
                { assert file("${outputDir}/atlas/sample1/adata_matched.h5ad").exists() },
                { assert file("${outputDir}/rctd/sample1/rctd_cell_types.csv").exists() },
                { assert file("${outputDir}/spacemarkers/sample1/rctd_cell_types/LRscores.rds").exists() },
                { assert file("${outputDir}/squidpy/sample1/rctd/figures/spatial_scatter.png").exists() },
                { assert file("${outputDir}/multiqc/multiqc_report.html").exists() }
            )
        }
    }

    test("RCTD full pipeline on segmented Visium HD with remote ref") {

        tag "segmented"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/hdvisium-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                outdir = "output"
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                    external = false
                    n_top_genes = 1000
                }
                analyze {
                    spacemarkers = false // will not work yet with segmented outputs
                    squidpy = true
                }
                visium_hd = "cell_segmentations"
                ref_scrna = "https://datasets.cellxgene.cziscience.com/6c29f947-d85b-483e-b346-b163277dae5e.h5ad"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert file("${outputDir}/adata/sample1/adata.h5ad").exists() },
                { assert file("${outputDir}/atlas/${params.ref_scrna.tokenize("/")[-1]}").exists() },
                { assert file("${outputDir}/atlas/sample1/adata_matched.h5ad").exists() },
                { assert file("${outputDir}/rctd/sample1/rctd_cell_types.csv").exists() },
                //{ assert file("${outputDir}/spacemarkers/sample1/rctd_cell_types/LRscores.rds").exists() }, // will not work yet with segmented outputs
                { assert file("${outputDir}/squidpy/sample1/rctd/figures/spatial_scatter.png").exists() },
                { assert file("${outputDir}/multiqc/multiqc_report.html").exists() }
            )
        }
    }

    test("Visium SD with external deconvolution") {

        tag "external"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/sdvisium-test.csv"
                max_memory = "8.GB"
                max_cpus = 4
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = false
                    external = true
                }
                analyze {
                    spacemarkers = true
                    squidpy = true
                }
                outdir = "output"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert file("${outputDir}/adata/sample1/adata.h5ad").exists() },
                { assert file("${outputDir}/spacemarkers/sample1/visium_cellular_compositions/IMScores.rds").exists() }
            )
        }

    }

    test("RCTD Anndata with reference deconvolution") {

        tag "anndata"
        tag "pipeline"

        when {
            params {
                input = "../../../tests/data/samplesheets/anndata-test.csv"
                anndata = true
                max_memory = "8.GB"
                max_cpus = 4
                umi_min = 10
                deconvolve {
                    bayestme = false
                    cogaps = false
                    rctd = true
                    external = false
                }
                analyze {
                    spacemarkers = false
                    squidpy = true
                    xsample = true
                }
                outdir = "output"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert file("${outputDir}/adata/sample1/adata.h5ad").exists() },
                {assert file("${outputDir}/atlas/sample1/adata_matched.h5ad").exists() },
                { assert file("${outputDir}/rctd/sample1/rctd_cell_types.csv").exists() },
                { assert file("${outputDir}/squidpy/sample1/rctd/figures/spatial_scatter.png").exists() },
                { assert file("${outputDir}/multiqc/multiqc_report.html").exists() }
            )
        }

    }

}
