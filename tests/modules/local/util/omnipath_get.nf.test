nextflow_process {
    name    "Test OMNIPATH_GET"
    script  "modules/local/util/main.nf"
    process "OMNIPATH_GET"

    test("Should run OMNIPATH_GET successfully with defaults") {

        tag "process"
        tag "omnipath"
        tag "util"

        when {
            params {
                max_memory = '4.GB'
                max_cpus   = 1
            }
            process {
            }
        }

        then {
            assert process.success
            assert process.out.versions
            assert process.out.db
        }
    }
    test("Should run OMNIPATH_GET successfully with params") {

        tag "process"
        tag "omnipath"
        tag "util"

        when {
            params {
                max_memory = '4.GB'
                max_cpus   = 1
                params.om_interaction_params = '{"resources":"CellPhoneDB"}'
                params.om_receiver_params = '{"category":"receptor"}'
                params.om_transmitter_params = '{"category":"ligand"}'
            }
            process {
            }
        }

        then {
            assert process.success
            assert process.out.versions
            assert process.out.db
        }
    }
}