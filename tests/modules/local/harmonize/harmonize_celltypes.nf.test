nextflow_process {

    name "Test HARMONIZE_CELL_TYPES"
    script "modules/local/util/main.nf"
    process "HARMONIZE_CELL_TYPES"
    tag "process"
    tag "harmonize"

    test("Cross-sample pattern matching with correct mapping") {
        
        tag "cross-sample"
        
        setup {
            run("CREATE_HARMONIZE_PATTERNS") {
                script "tests/data/create_harmonize_patterns.nf"
                process {
                    """
                    input[0] = "cross_sample"
                    """
                }

            }
        }
        
        when {
            params {
                max_memory = "8.GB"
                harmonize {
                    enabled = true
                    method = "hierarchical"
                    cut_height = 0.3
                    min_samples_per_cluster = 1
                    confidence_threshold = 0.6
                }
            }
            process {
                """
                input[0] = CREATE_HARMONIZE_PATTERNS.out.patterns.map { files ->
                    files = files.reverse()
                    tuple(files.collect { it.parent.fileName.toString() }, files)
                }
                input[1] = 0.3
                input[2] = 1
                input[3] = 0.6
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.mapping[0]).exists() },
                { assert path(process.out.consensus[0]).exists() },
                { assert path(process.out.diagnostics[0]).exists() }
            )

            // Verify mapping file structure
            def mapping = path(process.out.mapping[0]).text
            assert mapping.contains("original_cell_type")
            assert mapping.contains("harmonized_cell_type")
            assert mapping.contains("sample1.")
            assert mapping.contains("sample2.")
            
            def mappingLines = mapping.split('\n').drop(1)
            def rows = mappingLines.collect { it.split(',') }
            def shared = rows.find { it[0] == "sample1.shared" }
            def match = rows.find { it[0] == "sample2.cluster-B" }
            assert shared && match && shared[1] == match[1]
            def consensus = path(process.out.consensus[0]).text
            assert consensus.contains("0001,")
            assert !consensus.contains("0000,")
        }
    }

    test("Reject missing unnamed index") {
        tag "invalid-input"
        setup {
            run("CREATE_HARMONIZE_PATTERNS") {
                script "tests/data/create_harmonize_patterns.nf"
                process {
                    """
                    input[0] = "no_index"
                    """
                }
            }
        }
        when {
            params {
                max_memory = "8.GB"
            }
            process {
                """
                input[0] = CREATE_HARMONIZE_PATTERNS.out.patterns.map { files ->
                    tuple(files.collect { it.parent.fileName.toString() }, files)
                }
                input[1] = 0.3
                input[2] = 2
                input[3] = 0.7
                """
            }
        }
        then {
            assert !process.success
        }
    }

    test("One sample with several patterns") {
        tag "single-sample"
        setup {
            run("CREATE_HARMONIZE_PATTERNS") {
                script "tests/data/create_harmonize_patterns.nf"
                process {
                    """
                    input[0] = "random"
                    """
                }
            }
        }
        when {
            params {
                max_memory = "8.GB"
            }
            process {
                """
                input[0] = CREATE_HARMONIZE_PATTERNS.out.patterns.map { files ->
                    tuple(['sample1'], [files.find { it.parent.fileName.toString() == 'sample1' }])
                }
                input[1] = 0.3
                input[2] = 1
                input[3] = 0.0
                """
            }
        }
        then {
            assert process.success
            assert path(process.out.mapping[0]).text.contains('sample1.')
        }
