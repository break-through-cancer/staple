nextflow_process {
    name    "Test SPACEMARKERS"
    script  "modules/local/spacemarkers/nextflow/main.nf"
    process "SPACEMARKERS"

    test("Should run undirected on a small sample by default") {

        tag "process"
        tag "spacemarkers"

        when {
            params {
                max_memory = '8.GB'
                max_cpus   = 2
                sm_directed = ''
                sm_patterns_uns = 'cell_type_composition'
                sm_spot_diameter = ''
            }
            process {
                """
                input[0] = [[id:"sample"], file("${projectDir}/tests/data/rctd.h5ad")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.IMscores
            assert !process.out.LRscores
        }
    }

    test("Should run directed when forced") {

        tag "process"
        tag "spacemarkers"

        when {
            params {
                max_memory = '8.GB'
                max_cpus   = 2
                sm_directed = true
                sm_patterns_uns = 'cell_type_composition'
                sm_spot_diameter = ''
            }
            process {
                """
                input[0] = [[id:"sample"], file("${projectDir}/tests/data/rctd.h5ad")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.IMscores
            assert process.out.LRscores
        }
    }

    test("Should accept a spot diameter override") {

        tag "process"
        tag "spacemarkers"

        when {
            params {
                max_memory = '8.GB'
                max_cpus   = 2
                sm_directed = false
                sm_patterns_uns = 'cell_type_composition'
                sm_spot_diameter = 90
            }
            process {
                """
                input[0] = [[id:"sample"], file("${projectDir}/tests/data/rctd.h5ad")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.IMscores
        }
    }
}
